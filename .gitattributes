# Enforce consistent line endings across Windows, Linux, and macOS
* text=auto eol=lf

# Windows scripts require CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary test fixtures & media assets must never undergo line-ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.gif binary
*.ico binary
*.tiff binary
*.pdf binary
*.zip binary
